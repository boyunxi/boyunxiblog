# MCP SSH 服务器配置示例
# 复制为 .env 并填入真实值（推荐使用 SSH 密钥，密码仅为备选）

# 服务器地址（必填）
SSH_HOST=154.8.175.76

# SSH 用户名（默认 ubuntu）
SSH_USER=ubuntu

# SSH 端口（默认 22）
SSH_PORT=22

# 认证方式二选一：
# 方式一（推荐）：SSH 私钥路径
# SSH_KEY_PATH=/home/ubuntu/.ssh/id_ed25519

# 方式二：密码（会用 sshpass，密码会出现在进程参数中，仅作备选）
# SSH_PASSWORD=your-password
