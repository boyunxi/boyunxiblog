# 复制为 .env 并填写真实值：cp .env.example .env
# 注意：.env / .env.local 已被 gitignore，不要提交真实密钥

# NextAuth 会话签名密钥（必填，可用 openssl rand -base64 32 生成）
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://boyunxi.cn
NEXT_PUBLIC_SITE_URL=https://boyunxi.cn

# SQLite（Docker 部署时由 entrypoint.sh 将库软链到持久化卷）
DATABASE_URL=file:./dev.db

# MinIO 对象存储（必填，docker compose 部署时服务名为 minio）
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=blog-images
MINIO_PUBLIC_URL=https://boyunxi.cn/images

# next/image 允许的远程图片域名白名单（逗号分隔）
IMAGES_REMOTE_HOSTS=boyunxi.cn
