# ============================================================
# Git line-ending & file-type normalization
# 目的：统一源码为 LF，避免 CRLF 造成"假改动"污染 git status
# ============================================================

# 默认：由 git 自动识别文本文件，工作区与仓库统一使用 LF
* text=auto eol=lf

# ---------- 源码 / 配置：强制 LF ----------
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# ---------- 二进制：禁止换行符转换与 diff ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.svg   -text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.db    binary
*.sqlite binary

# ---------- 语言统计 / 归档 ----------
*.lock        -diff
package-lock.json -diff
*.log         -diff
